{
  "name": "field-ops-hub",
  "version": "1.0.0",
  "description": "J&D Western Electric Field Operations Hub",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:local": "node server.js",
